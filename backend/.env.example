# Groundly backend — example env (safe to commit)
# Copy to backend/.env and fill secrets.

# Prefer a single DATABASE_URL, or build from pieces:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=groundly
# DB_USER=postgres
# DB_PASSWORD=your-password

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/groundly
DATABASE_URL_SYNC=postgresql://postgres:YOUR_PASSWORD@localhost:5432/groundly
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-change-me-groundly-phase1
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REGISTER_ENABLED=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

EMBEDDING_MODE=fake
EMBEDDING_MODEL=text-embedding-3-small

# fake | anthropic | groq
LLM_MODE=fake
# anthropic example: claude-sonnet-4-20250514
# groq example: llama-3.3-70b-versatile
LLM_MODEL=claude-sonnet-4-20250514

RELEVANCE_THRESHOLD=0.012
RETRIEVAL_TOP_K=6
UPLOAD_DIR=uploads

SEED_ADMIN_EMAIL=admin@riverside.demo
SEED_ADMIN_PASSWORD=riverside-demo

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000,null
