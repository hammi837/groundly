# Copy to `.env` and adjust. Never commit real secrets.

DATABASE_URL=postgresql+asyncpg://groundly:groundly@localhost:5433/groundly
DATABASE_URL_SYNC=postgresql://groundly:groundly@localhost:5433/groundly
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-change-me-groundly-phase1
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REGISTER_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# fake = offline deterministic vectors (Phase 2 local). openai = real embeddings.
EMBEDDING_MODE=fake
# fake | anthropic | groq
LLM_MODE=fake
# groq: llama-3.3-70b-versatile · anthropic: claude-sonnet-4-20250514
LLM_MODEL=llama-3.3-70b-versatile
UPLOAD_DIR=uploads
SEED_ADMIN_EMAIL=admin@riverside.demo
SEED_ADMIN_PASSWORD=riverside-demo
