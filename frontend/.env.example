# Groundly admin frontend — example env (safe to commit)
# Copy to frontend/.env

# Leave empty to use the Vite `/api` proxy (see vite.config.ts)
# Set to a full URL in production, e.g. https://api.yourdomain.com
VITE_API_BASE_URL=

# Used by vite.config.ts proxy when VITE_API_BASE_URL is empty
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

VITE_APP_NAME=Groundly
